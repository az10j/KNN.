    </main>

    <script>
        // 1. TẬP DỮ LIỆU HUẤN LƯYỆN
        const IRIS_SUBSET = [
            { x: 5.1, y: 3.5, label: 'Setosa' }, { x: 4.9, y: 3.0, label: 'Setosa' },
            { x: 4.7, y: 3.2, label: 'Setosa' }, { x: 4.6, y: 3.1, label: 'Setosa' },
            { x: 5.0, y: 3.6, label: 'Setosa' }, { x: 5.4, y: 3.9, label: 'Setosa' },
            { x: 7.0, y: 3.2, label: 'Versicolor' }, { x: 6.4, y: 3.2, label: 'Versicolor' },
            { x: 6.9, y: 3.1, label: 'Versicolor' }, { x: 5.5, y: 2.3, label: 'Versicolor' },
            { x: 6.5, y: 2.8, label: 'Versicolor' }, { x: 5.7, y: 2.8, label: 'Versicolor' },
            { x: 6.3, y: 3.3, label: 'Virginica' }, { x: 5.8, y: 2.7, label: 'Virginica' },
            { x: 7.1, y: 3.0, label: 'Virginica' }, { x: 6.3, y: 2.9, label: 'Virginica' },
            { x: 6.5, y: 3.0, label: 'Virginica' }, { x: 7.6, y: 3.0, label: 'Virginica' }
        ];

        const SIMPLE_DATASET = [
            { x: 2.0, y: 3.0, label: 'Setosa' },
            { x: 3.0, y: 3.5, label: 'Setosa' },
            { x: 6.0, y: 6.5, label: 'Versicolor' },
            { x: 7.0, y: 7.0, label: 'Versicolor' },
            { x: 8.0, y: 2.0, label: 'Virginica' }
        ];

        // Trạng thái ứng dụng
        let currentDataset = IRIS_SUBSET;
        let queryPoint = { x: 5.2, y: 3.1 };
        let kValue = 3;

        // Trạng thái Zoom & Pan
        let zoomLevel = 1.0;
        let panOffset = { x: 0, y: 0 };
        let isDragging = false;
        let startDragPos = { x: 0, y: 0 };

        // Bảng màu cho các lớp
        const CLASS_COLORS = {
            'Setosa': { fill: '#f43f5e', border: '#be123c', text: 'text-rose-400' },
            'Versicolor': { fill: '#34d399', border: '#059669', text: 'text-emerald-400' },
            'Virginica': { fill: '#38bdf8', border: '#0284c7', text: 'text-sky-400' }
        };

        // 2. HÀM TÍNH KHOẢNG CÁCH EUCLIDEAN DUY NHẤT
        function calculateEuclideanDistance(p1, p2) {
            const dx = p1.x - p2.x;
            const dy = p1.y - p2.y;
            return Math.sqrt(dx * dx + dy * dy);
        }

        // Đơn vị vẽ Canvas
        const canvas = document.getElementById('knnCanvas');
        const ctx = canvas.getContext('2d');
        const PADDING = 40;

        function resizeCanvas() {
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * window.devicePixelRatio;
            canvas.height = rect.height * window.devicePixelRatio;
            render();
        }
        window.addEventListener('resize', resizeCanvas);

        // Chuyển đổi tọa độ dữ liệu sang tọa độ Canvas (Có tính Zoom & Pan)
        function toCanvasCoords(p) {
            const w = canvas.width - PADDING * 2;
            const h = canvas.height - PADDING * 2;

            let cx = PADDING + (p.x / 10) * w;
            let cy = canvas.height - (PADDING + (p.y / 10) * h);

            const centerX = canvas.width / 2;
            const centerY = canvas.height / 2;

            return {
                x: (cx - centerX) * zoomLevel + centerX + panOffset.x,
                y: (cy - centerY) * zoomLevel + centerY + panOffset.y
            };
        }

        // 3. THUẬT TOÁN K-NN & HIỂN THỊ DỮ LIỆU
        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 1. Vẽ Lưới Tọa Độ
            ctx.strokeStyle = '#1e293b';
            ctx.lineWidth = 1 * window.devicePixelRatio;
            ctx.font = `${10 * window.devicePixelRatio * zoomLevel}px Inter`;
            ctx.fillStyle = '#64748b';

            for (let i = 0; i <= 10; i++) {
                const pos = toCanvasCoords({ x: i, y: i });
                ctx.beginPath();
                ctx.moveTo(pos.x, 0);
                ctx.lineTo(pos.x, canvas.height);
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(0, pos.y);
                ctx.lineTo(canvas.width, pos.y);
                ctx.stroke();

                ctx.fillText(i, pos.x - 3, canvas.height - 10 * window.devicePixelRatio);
                if (i > 0) ctx.fillText(i, 10 * window.devicePixelRatio, pos.y + 4);
            }

            // 2. Tính Khoảng Cách Euclidean Cho Toàn Bộ Tập Huấn Luyện
            const evaluatedPoints = currentDataset.map(pt => ({
                ...pt,
                distance: calculateEuclideanDistance(queryPoint, pt)
            }));

            // 3. Sắp Xếp Tăng Dần Dựa Trên Khoảng Cách
            evaluatedPoints.sort((a, b) => a.distance - b.distance);

            // 4. Lọc Lấy K Điểm Gần Nhất
            const neighbors = evaluatedPoints.slice(0, Math.min(kValue, evaluatedPoints.length));
            const maxRadiusDistance = neighbors.length > 0 ? neighbors[neighbors.length - 1].distance : 0;

            // 5. Vẽ Đường Tròn Khoanh Vùng Láng Giềng K
            const queryCanvasPos = toCanvasCoords(queryPoint);
            if (neighbors.length > 0) {
                const edgePoint = toCanvasCoords({ x: queryPoint.x + maxRadiusDistance, y: queryPoint.y });
                const radiusPx = Math.abs(edgePoint.x - queryCanvasPos.x);

                ctx.save();
                ctx.beginPath();
                ctx.arc(queryCanvasPos.x, queryCanvasPos.y, radiusPx, 0, 2 * Math.PI);
                ctx.fillStyle = 'rgba(99, 102, 241, 0.08)';
                ctx.fill();
                ctx.strokeStyle = 'rgba(99, 102, 241, 0.4)';
                ctx.lineWidth = 1.5 * window.devicePixelRatio;
                ctx.setLineDash([4 * window.devicePixelRatio, 4 * window.devicePixelRatio]);
                ctx.stroke();
                ctx.restore();
            }

            // 6. Vẽ Nối Các Đường Từ Điểm Truy Vấn Đến K Láng Giềng
            neighbors.forEach(n => {
                const nPos = toCanvasCoords(n);
                ctx.beginPath();
                ctx.moveTo(queryCanvasPos.x, queryCanvasPos.y);
                ctx.lineTo(nPos.x, nPos.y);
                ctx.strokeStyle = 'rgba(251, 191, 36, 0.6)';
                ctx.lineWidth = 1.5 * window.devicePixelRatio;
                ctx.stroke();
            });

            // 7. Vẽ Các Điểm Dữ Liệu
            currentDataset.forEach(pt => {
                const pos = toCanvasCoords(pt);
                const isNeighbor = neighbors.some(n => n.x === pt.x && n.y === pt.y && n.label === pt.label);
                const colorInfo = CLASS_COLORS[pt.label] || { fill: '#cbd5e1', border: '#64748b' };

                ctx.beginPath();
                const radius = (isNeighbor ? 7 : 5) * window.devicePixelRatio * Math.max(zoomLevel, 0.7);
                ctx.arc(pos.x, pos.y, radius, 0, 2 * Math.PI);
                ctx.fillStyle = colorInfo.fill;
                ctx.fill();
                ctx.lineWidth = (isNeighbor ? 2.5 : 1.5) * window.devicePixelRatio;
                ctx.strokeStyle = isNeighbor ? '#fbbf24' : colorInfo.border;
                ctx.stroke();
            });

            // 8. Vẽ Điểm Cần Dự Đoán
            ctx.beginPath();
            ctx.arc(queryCanvasPos.x, queryCanvasPos.y, 8 * window.devicePixelRatio * Math.max(zoomLevel, 0.7), 0, 2 * Math.PI);
            ctx.fillStyle = '#f59e0b';
            ctx.fill();
            ctx.lineWidth = 2 * window.devicePixelRatio;
            ctx.strokeStyle = '#ffffff';
            ctx.stroke();

            // Cập nhật các bảng kết quả
            updateUI(neighbors, evaluatedPoints);
        }

        // Cập nhật giao diện khi có thay đổi
        function updateUI(neighbors, evaluatedPoints) {
            // Đếm phiếu bầu bình đẳng
            const votes = {};
            neighbors.forEach(n => {
                votes[n.label] = (votes[n.label] || 0) + 1;
            });

            // Lớp chiến thắng có số phiếu đông nhất
            let predictedClass = 'Chưa xác định';
            let maxVote = -1;
            Object.entries(votes).forEach(([cls, voteVal]) => {
                if (voteVal > maxVote) {
                    maxVote = voteVal;
                    predictedClass = cls;
                }
            });

            // 1. Thẻ Nhãn Dự Đoán
            const predictedClassName = document.getElementById('predictedClassName');
            const predictedClassIcon = document.getElementById('predictedClassIcon');
            predictedClassName.innerText = predictedClass;
            const classColor = CLASS_COLORS[predictedClass] || { text: 'text-slate-200', fill: '#64748b' };
            predictedClassName.className = `text-xl font-bold ${classColor.text}`;
            predictedClassIcon.style.backgroundColor = classColor.fill;
            predictedClassIcon.innerText = predictedClass.charAt(0);

            // 2. Thanh Biểu Đồ Phiếu Bầu
            const votingBars = document.getElementById('votingBars');
            votingBars.innerHTML = '';
            const allClasses = ['Setosa', 'Versicolor', 'Virginica'];
            allClasses.forEach(cls => {
                const clsVote = votes[cls] || 0;
                const percentage = kValue > 0 ? ((clsVote / kValue) * 100).toFixed(1) : 0;
                const cInfo = CLASS_COLORS[cls];

                const barHtml = `
                    <div>
                        <div class="flex justify-between text-[11px] mb-0.5">
                            <span class="text-slate-300 font-medium">${cls}</span>
                            <span class="text-slate-400 font-mono">${clsVote}/${kValue} Phiếu (${percentage}%)</span>
                        </div>
                        <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
                            <div class="h-full transition-all duration-300" style="width: ${percentage}%; background-color: ${cInfo.fill}"></div>
                        </div>
                    </div>
                `;
                votingBars.insertAdjacentHTML('beforeend', barHtml);
            });

            // 3. Bảng Xếp Hạng Top-K
            const neighborsTableBody = document.getElementById('neighborsTableBody');
            neighborsTableBody.innerHTML = '';
            neighbors.forEach((n, idx) => {
                const cInfo = CLASS_COLORS[n.label] || { text: 'text-slate-300' };
                const row = `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="p-2 font-mono font-semibold text-slate-400">#${idx + 1}</td>
                        <td class="p-2 font-medium ${cInfo.text}">${n.label}</td>
                        <td class="p-2 font-mono text-slate-400">(${n.x.toFixed(1)}, ${n.y.toFixed(1)})</td>
                        <td class="p-2 text-right font-mono text-amber-400 font-semibold">${n.distance.toFixed(3)} cm</td>
                    </tr>
                `;
                neighborsTableBody.insertAdjacentHTML('beforeend', row);
            });

            // 4. Nhật Ký Giải Thích Chi Tiết
            const decisionLog = document.getElementById('decisionLog');
            decisionLog.innerHTML = `
                <div class="text-indigo-400">Bước 1: Tọa độ mẫu hoa cần dự đoán đặt tại X = ${queryPoint.x.toFixed(1)}, Y = ${queryPoint.y.toFixed(1)}</div>
                <div>Bước 2: Tính khoảng cách Euclidean đến toàn bộ ${evaluatedPoints.length} điểm dữ liệu trong tập huấn luyện.</div>
                <div>Bước 3: Sắp xếp danh sách tăng dần và chọn Top K = ${kValue} láng giềng gần nhất.</div>
                <div>Bước 4: Tổng hợp số lượng bỏ phiếu đa số từ K láng giềng:</div>
                <div class="pl-4 border-l border-slate-800 text-slate-400">
                    ${Object.entries(votes).map(([c, v]) => `- ${c}: ${v}/${kValue} phiếu bầu`).join('<br>')}
                </div>
                <div class="text-emerald-400 font-semibold">Bước 5: Kết Luận Phân Loại Thuộc Loài Hoa: ${predictedClass}</div>
            `;
        }

        // --- BẮT SỰ KIỆN TƯƠNG TÁC Ô NHẬP SỐ ---
        const kInput = document.getElementById('kInput');
        const queryXInput = document.getElementById('queryXInput');
        const queryYInput = document.getElementById('queryYInput');

        // Bắt sự kiện khi gõ K
        kInput.addEventListener('input', (e) => {
            let val = parseInt(e.target.value);
            if (!isNaN(val) && val >= 1 && val <= 15) {
                kValue = val;
                render();
            }
        });

        // Bắt sự kiện khi gõ X
        queryXInput.addEventListener('input', (e) => {
            let val = parseFloat(e.target.value);
            if (!isNaN(val)) {
                queryPoint.x = Math.min(Math.max(val, 0), 10);
                render();
            }
        });

        // Bắt sự kiện khi gõ Y
        queryYInput.addEventListener('input', (e) => {
            let val = parseFloat(e.target.value);
            if (!isNaN(val)) {
                queryPoint.y = Math.min(Math.max(val, 0), 10);
                render();
            }
        });

        // Thay đổi tập dữ liệu
        document.getElementById('datasetSelect').addEventListener('change', (e) => {
            currentDataset = e.target.value === 'iris' ? IRIS_SUBSET : SIMPLE_DATASET;
            render();
        });

        // --- XỬ LÝ ZOOM & PAN TRÊN CANVAS ---
        canvas.addEventListener('wheel', (e) => {
            e.preventDefault();
            const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
            const newZoom = zoomLevel * zoomFactor;
            if (newZoom >= 0.5 && newZoom <= 5.0) {
                zoomLevel = newZoom;
                render();
            }
        }, { passive: false });

        canvas.addEventListener('mousedown', (e) => {
            isDragging = true;
            startDragPos = { x: e.clientX - panOffset.x, y: e.clientY - panOffset.y };
        });

        window.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            panOffset.x = e.clientX - startDragPos.x;
            panOffset.y = e.clientY - startDragPos.y;
            render();
        });

        window.addEventListener('mouseup', () => {
            isDragging = false;
        });

        // Nút đặt lại góc nhìn ban đầu
        document.getElementById('resetViewBtn').addEventListener('click', () => {
            zoomLevel = 1.0;
            panOffset = { x: 0, y: 0 };
            render();
        });

        // Thêm điểm dữ liệu mới
        document.getElementById('addDataForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const newX = parseFloat(document.getElementById('newX').value);
            const newY = parseFloat(document.getElementById('newY').value);
            const newClass = document.getElementById('newClass').value;

            currentDataset.push({ x: newX, y: newY, label: newClass });
            render();
        });

        // Khởi chạy
        resizeCanvas();
    </script>
</body>
</html>
